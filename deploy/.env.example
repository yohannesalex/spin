# Copy to deploy/.env on the server and fill in. Never commit deploy/.env.

# Your domain, e.g. spindraw.duckdns.org. It must point to this server's public IP.
# Caddy gets the HTTPS certificate for it automatically.
DOMAIN=

# Generate each with: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=

# First admin account, created by `docker compose exec api pnpm seed`.
SEED_ADMIN_PHONE=+251941167843
SEED_ADMIN_NAME=Platform Admin
SEED_ADMIN_PASSWORD=

# SMS: console (codes only appear in the API log) | afromessage
SMS_PROVIDER=console
AFROMESSAGE_TOKEN=
AFROMESSAGE_IDENTIFIER_ID=
AFROMESSAGE_SENDER_ID=

# Optional
RECEIPT_RELAY_URL=
TURNSTILE_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# --- TESTING ONLY: delete these three lines and set NODE_ENV=production before real money ---
NODE_ENV=staging
OTP_FIXED_CODE=0000
DEPOSIT_SIMULATION=true
