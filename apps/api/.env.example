NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://spin:spin@localhost:5433/spin?schema=public
REDIS_URL=redis://localhost:6380
# Public origin of the web app (CORS + CSRF origin check)
WEB_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
COOKIE_SECURE=false
# Where receipt images and raw receipts are stored (outside any web root)
STORAGE_DIR=./storage
# SMS: console (dev) | afromessage
SMS_PROVIDER=console
AFROMESSAGE_TOKEN=
AFROMESSAGE_SENDER_ID=
AFROMESSAGE_IDENTIFIER_ID=
# Optional relay inside Ethiopia for receipt fetching (REQ-DEP-03). If set, receipt URLs are
# fetched via GET {RECEIPT_RELAY_URL}?url=<encoded receipt url>
RECEIPT_RELAY_URL=
# Optional bot protection on registration (REQ-SEC-04)
TURNSTILE_SECRET=
# Optional Telegram alerts to admins (REQ-NOT-01)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# Seed admin
SEED_ADMIN_PHONE=+251911000000
SEED_ADMIN_PASSWORD=Admin12345
SEED_ADMIN_NAME=Platform Admin
